static float randomRange(float minValue, float maxValue) {
    float t = static_cast<float>(rand()) / static_cast<float>(RAND_MAX);
    return minValue + (maxValue - minValue) * t;
}

static const std::vector<float>& eastWestSidewalkBands() {
    static std::vector<float> lanes;
    if (lanes.empty()) {
        for (int z = -400; z <= 400; z += 200) {
            lanes.push_back(std::max(CITY_WALK_MIN, std::min(CITY_WALK_MAX, static_cast<float>(z) + SIDEWALK_OFFSET)));
            lanes.push_back(std::max(CITY_WALK_MIN, std::min(CITY_WALK_MAX, static_cast<float>(z) - SIDEWALK_OFFSET)));
        }
        lanes.push_back(CITY_WALK_MIN);
        lanes.push_back(CITY_WALK_MAX);
    }
    return lanes;
}

static const std::vector<float>& northSouthSidewalkBands() {
    static std::vector<float> lanes;
    if (lanes.empty()) {
        for (int x = -400; x <= 400; x += 200) {
            lanes.push_back(std::max(CITY_WALK_MIN, std::min(CITY_WALK_MAX, static_cast<float>(x) + SIDEWALK_OFFSET)));
            lanes.push_back(std::max(CITY_WALK_MIN, std::min(CITY_WALK_MAX, static_cast<float>(x) - SIDEWALK_OFFSET)));
        }
        lanes.push_back(CITY_WALK_MIN);
        lanes.push_back(CITY_WALK_MAX);
    }
    return lanes;
}

static void initializePedestrianAppearance(Pedestrian &p) {
    auto clamp01 = [](float value) {
        return std::max(0.0f, std::min(1.0f, value));
    };

    p.y = 0.0f;
    p.progress = 0.0f;
    p.waiting = false;
    p.crossing = false;
    p.intersectionIndex = -1;
    p.roaming = false;
    p.pendingTurn = false;
    p.pendingAxis = 0;
    p.pauseTimer = 0.0f;
    p.currentSpeed = 0.0f;
    p.motionAmount = 0.2f;
    p.walkPhase = randomRange(0.0f, static_cast<float>(M_PI) * 2.0f);
    p.legAngle = sinf(p.walkPhase) * 6.0f;
    p.limbForward = (p.legAngle >= 0.0f);
    p.heightScale = 0.94f + (rand() % 24) / 100.0f;
    p.widthScale = 0.90f + (rand() % 20) / 100.0f;

    p.r = 0.2f + (rand() % 70) / 100.0f;
    p.g = 0.2f + (rand() % 70) / 100.0f;
    p.b = 0.2f + (rand() % 70) / 100.0f;

    float accentSeed = (rand() % 100) / 100.0f;
    p.accentR = clamp01(0.25f + accentSeed * 0.55f + p.r * 0.35f);
    p.accentG = clamp01(0.25f + (1.0f - accentSeed) * 0.45f + p.g * 0.35f);
    p.accentB = clamp01(0.3f + (0.5f - accentSeed) * 0.35f + p.b * 0.35f);

    p.shoeR = clamp01(0.12f + (rand() % 35) / 200.0f);
    p.shoeG = clamp01(0.12f + (rand() % 25) / 180.0f);
    p.shoeB = clamp01(0.12f + (rand() % 40) / 120.0f);

    p.hasBackpack = (rand() % 5 == 0);
    p.hasHat = (rand() % 6 == 0);
    if (p.hasHat) {
        p.hatR = clamp01(p.accentR * 0.8f + 0.1f);
        p.hatG = clamp01(p.accentG * 0.8f + 0.08f);
        p.hatB = clamp01(p.accentB * 0.8f + 0.05f);
    } else {
        p.hatR = p.hatG = p.hatB = 0.0f;
    }
}

static void assignRoamTarget(Pedestrian &p, bool allowAxisSwitch) {
    p.crossing = false;
    p.intersectionIndex = -1;
    p.waiting = false;

    const auto &eastWest = eastWestSidewalkBands();
    const auto &northSouth = northSouthSidewalkBands();

    bool stayOnAxis = true;
    if (allowAxisSwitch && (rand() % 100) < 28) {
        if (p.crossAxis == 1 && !northSouth.empty()) {
            float candidateX = northSouth[rand() % northSouth.size()];
            p.targetX = candidateX;
            p.targetZ = p.z;
            p.pendingTurn = true;
            p.pendingAxis = 0;
            stayOnAxis = false;
        } else if (p.crossAxis == 0 && !eastWest.empty()) {
            float candidateZ = eastWest[rand() % eastWest.size()];
            p.targetX = p.x;
            p.targetZ = candidateZ;
            p.pendingTurn = true;
            p.pendingAxis = 1;
            stayOnAxis = false;
        }
    }

    if (stayOnAxis) {
        p.pendingTurn = false;
        p.pendingAxis = p.crossAxis;
        float current = (p.crossAxis == 1) ? p.x : p.z;
        float distance = randomRange(120.0f, 260.0f);
        int direction = (rand() % 2) ? 1 : -1;
        float goal = current + direction * distance;
        goal = std::max(CITY_WALK_MIN, std::min(CITY_WALK_MAX, goal));

        if (std::fabs(goal - current) < 10.0f) {
            goal = current - direction * distance;
            goal = std::max(CITY_WALK_MIN, std::min(CITY_WALK_MAX, goal));
        }
        if (std::fabs(goal - current) < 8.0f) {
            goal = (direction > 0) ? CITY_WALK_MAX : CITY_WALK_MIN;
        }

        if (p.crossAxis == 1) {
            p.targetX = goal;
            p.targetZ = p.z;
        } else {
            p.targetZ = goal;
            p.targetX = p.x;
        }
    }

    float dirX = p.targetX - p.x;
    float dirZ = p.targetZ - p.z;
    float len = std::sqrt(dirX * dirX + dirZ * dirZ);
    if (len > 0.0001f) {
        p.moveDirX = dirX / len;
        p.moveDirZ = dirZ / len;
    } else {
        if (p.crossAxis == 1) {
            p.moveDirX = (rand() % 2) ? 1.0f : -1.0f;
            p.moveDirZ = 0.0f;
        } else {
            p.moveDirX = 0.0f;
            p.moveDirZ = (rand() % 2) ? 1.0f : -1.0f;
        }
    }

    if (p.crossAxis == 1) {
        p.dir = (p.moveDirX >= 0.0f) ? 1 : -1;
    } else {
        p.dir = (p.moveDirZ >= 0.0f) ? 1 : -1;
    }
}

static size_t countRoamingPedestrians() {
    size_t count = 0;
    for (const auto &ped : pedestrians) {
        if (ped.roaming) {
            ++count;
        }
    }
    return count;
}

static void spawnRoamingPedestrian() {
    if (pedestrians.size() >= MAX_TOTAL_PEDESTRIANS) {
        return;
    }
    if (countRoamingPedestrians() >= MAX_ROAMING_PEDESTRIANS) {
        return;
    }

    const auto &eastWest = eastWestSidewalkBands();
    const auto &northSouth = northSouthSidewalkBands();
    if (eastWest.empty() || northSouth.empty()) {
        return;
    }

    Pedestrian p{};
    initializePedestrianAppearance(p);
    p.roaming = true;
    p.intersectionIndex = -1;
    p.speed = 0.16f + (rand() % 60) / 220.0f; // roughly 0.16 - 0.43 units per frame

    if (rand() % 2 == 0) {
        p.crossAxis = 0; // move north-south
        p.x = northSouth[rand() % northSouth.size()];
        p.z = randomRange(CITY_WALK_MIN, CITY_WALK_MAX);
    } else {
        p.crossAxis = 1; // move east-west
        p.z = eastWest[rand() % eastWest.size()];
        p.x = randomRange(CITY_WALK_MIN, CITY_WALK_MAX);
    }

    p.targetX = p.x;
    p.targetZ = p.z;
    assignRoamTarget(p, false);
    p.motionAmount = 0.6f;
    pedestrians.push_back(p);
}

static void spawnCrosswalkPedestrian() {
    if (pedestrians.size() >= MAX_TOTAL_PEDESTRIANS) {
        return;
    }
    if (intersections.empty()) {
        return;
    }

    Pedestrian p{};
    initializePedestrianAppearance(p);
    p.speed = 0.008f + (rand() % 15) / 1000.0f;
    p.waiting = true;
    p.crossing = false;
    p.roaming = false;
    p.intersectionIndex = rand() % intersections.size();
    p.crossAxis = rand() % 2;
    p.dir = (rand() % 2) ? 1 : -1;

    const Intersection &it = intersections[p.intersectionIndex];
    float sidewalkOffset = (rand() % 2) ? 12.0f : -12.0f;
    if (p.crossAxis == 0) {
        p.x = it.x + sidewalkOffset;
        p.z = (p.dir == 1) ? (it.z - 22.0f) : (it.z + 22.0f);
        p.moveDirX = 0.0f;
        p.moveDirZ = (p.dir > 0) ? 1.0f : -1.0f;
    } else {
        p.x = (p.dir == 1) ? (it.x - 22.0f) : (it.x + 22.0f);
        p.z = it.z + sidewalkOffset;
        p.moveDirX = (p.dir > 0) ? 1.0f : -1.0f;
        p.moveDirZ = 0.0f;
    }

    p.targetX = p.x;
    p.targetZ = p.z;
    p.motionAmount = 0.2f;
    pedestrians.push_back(p);
}

Intersection makeIntersection(float x, float z, LightState horizontal, LightState vertical, int timer) {
    Intersection ix;
    ix.x = x;
    ix.z = z;
    ix.horizontalLight = horizontal;
    ix.verticalLight = vertical;
    ix.lightTimer = timer;
    ix.extraGreen = 0;
    ix.throughputRecent = 0.0f;
    ix.recentWaitSum = 0.0f;
    ix.recentWaitCount = 0.0f;
    return ix;
}

float cameraX = 0.0f;
float cameraY = 150.0f;  // Higher starting position for better city overview
float cameraZ = 250.0f;  // Further back to see more of the city
float cameraYaw = 0.0f;
float cameraPitch = -30.0f;  // Angle down to see the city layout
float cameraMoveSpeed = 2.0f;
bool autoRotate = false;
int frameCount = 0;

// Smooth camera variables for follow modes
float smoothCamX = 0.0f;
float smoothCamY = 150.0f;
float smoothCamZ = 250.0f;

// Smooth look-at target for follow modes (reduces camera shake)
float smoothLookX = 0.0f;
float smoothLookY = 0.0f;
float smoothLookZ = 0.0f;

// Camera modes
enum CameraMode {
    CAMERA_FREE,
    CAMERA_FOLLOW_CAR,
    CAMERA_FOLLOW_PEDESTRIAN,
    CAMERA_BUILDING_VIEW
};
CameraMode currentCameraMode = CAMERA_FREE;
int followTargetIndex = 0;

void drawPedestrian(const Pedestrian& p) {
    GLint previousShade = GL_SMOOTH;
    glGetIntegerv(GL_SHADE_MODEL, &previousShade);
    GLboolean normalizeWasEnabled = glIsEnabled(GL_NORMALIZE);

    glShadeModel(GL_SMOOTH);
    if (!normalizeWasEnabled) {
        glEnable(GL_NORMALIZE);
    }

    glPushMatrix();
    glTranslatef(p.x, p.y, p.z);

    float facing = 0.0f;
    float dirX = p.moveDirX;
    float dirZ = p.moveDirZ;
    if (std::fabs(dirX) < 0.0001f && std::fabs(dirZ) < 0.0001f) {
        if (p.crossAxis == 0) {
            facing = (p.dir > 0) ? 0.0f : 180.0f;
        } else {
            facing = (p.dir > 0) ? -90.0f : 90.0f;
        }
    } else {
        facing = std::atan2(dirX, dirZ) * 180.0f / static_cast<float>(M_PI);
    }
    glRotatef(facing, 0, 1, 0);

    auto clamp01 = [](float value) {
        return std::max(0.0f, std::min(1.0f, value));
    };

    float strideIntensity = clamp01(p.motionAmount);
    float strideFactor = 0.2f + 0.8f * strideIntensity;
    float walkPhase = p.walkPhase;
    float legSwing = sinf(walkPhase) * 28.0f * strideFactor;
    float armSwing = sinf(walkPhase + static_cast<float>(M_PI)) * 32.0f * strideFactor;
    float forearmBend = 18.0f + cosf(walkPhase * 0.8f) * 12.0f * strideFactor;
    float torsoBob = sinf(walkPhase * 2.0f) * 0.08f * (strideFactor * 0.8f + 0.2f);
    float torsoTwist = sinf(walkPhase) * 6.0f * strideFactor;
    float hipRoll = sinf(walkPhase) * 3.0f * strideFactor;
    float shoulderYaw = torsoTwist * 0.6f;
    float wristTilt = sinf(walkPhase * 2.4f) * 8.0f * strideFactor;
    
    // Neck rotation for natural head movement
    float neckTurn = sinf(walkPhase * 0.4f) * 8.0f * strideFactor; // Subtle left-right head turn
    float neckTilt = cosf(walkPhase * 0.5f) * 3.0f * strideFactor; // Slight forward-back nod
    
    // Blinking animation - blink every ~3 seconds with individual variation
    float blinkSeed = fmodf(fabsf(p.x * 1.3f + p.z * 0.7f), 100.0f);
    float blinkCycle = fmodf(frameCount * 0.05f + blinkSeed, 180.0f);
    float blinkAmount = (blinkCycle < 5.0f) ? (1.0f - blinkCycle / 5.0f) : 0.0f; // Quick blink

    float baseScale = p.heightScale;
    float widthScale = p.widthScale;

    glTranslatef(0.0f, 0.42f + torsoBob, 0.0f);

    float pantsR = clamp01(0.24f + 0.35f * p.r);
    float pantsG = clamp01(0.24f + 0.35f * p.g);
    float pantsB = clamp01(0.28f + 0.35f * p.b);

    float skinSeed = fmodf(fabsf(p.x * 0.73f + p.z * 0.38f), 120.0f);
    float skinBase = 0.68f + skinSeed * 0.0025f;
    float skinR = clamp01(skinBase);
    float skinG = clamp01(skinBase - 0.15f + fmodf(skinSeed, 40.0f) * 0.005f);
    float skinB = clamp01(skinBase - 0.28f + fmodf(skinSeed, 34.0f) * 0.006f);

    float hairSeed = fmodf(fabsf(p.x) * 0.17f + fabsf(p.z) * 0.13f, 1.0f);
    float hairR = clamp01(0.16f + hairSeed * 0.45f);
    float hairG = clamp01(0.1f + hairSeed * 0.32f);
    float hairB = clamp01(0.08f + hairSeed * 0.28f);

    glPushMatrix();
    glRotatef(hipRoll, 0, 0, 1);
    glRotatef(-torsoTwist * 0.4f, 0, 1, 0);
    glColor3f(pantsR, pantsG, pantsB);

    auto drawLeg = [&](float sideSign, float swingSign) {
        glPushMatrix();
        glTranslatef(sideSign * 0.25f * widthScale, 1.55f * baseScale, 0.0f);
        glRotatef(swingSign * legSwing, 1, 0, 0);

        glPushMatrix();
        glTranslatef(0.0f, -0.48f * baseScale, 0.0f);
        glScalef(0.26f * widthScale, 0.95f * baseScale, 0.28f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();

        glPushMatrix();
        glTranslatef(0.0f, -0.96f * baseScale, 0.0f);
        glutSolidSphere(0.15f * widthScale, 16, 16);
        glPopMatrix();

        glPushMatrix();
        glTranslatef(0.0f, -1.35f * baseScale, 0.02f);
        glScalef(0.22f * widthScale, 0.84f * baseScale, 0.25f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();

        glPushMatrix();
        glTranslatef(0.0f, -1.72f * baseScale, 0.05f);
        glutSolidSphere(0.11f * widthScale, 12, 12);
        glPopMatrix();

        glColor3f(p.shoeR, p.shoeG, p.shoeB);
        glPushMatrix();
        glTranslatef(0.0f, -1.83f * baseScale, 0.24f);
        glScalef(0.30f * widthScale, 0.12f * baseScale, 0.58f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();

        glColor3f(pantsR, pantsG, pantsB);
        glPopMatrix();
    };

    drawLeg(-1.0f, -1.0f);
    drawLeg(1.0f, 1.0f);
    glPopMatrix();

    glColor3f(pantsR * 0.8f, pantsG * 0.8f, pantsB * 0.8f);
    glPushMatrix();
    glTranslatef(0.0f, 1.9f * baseScale, 0.0f);
    glScalef(1.05f * widthScale, 0.18f * baseScale, 0.75f * widthScale);
    glutSolidCube(1.0f);
    glPopMatrix();

    glPushMatrix();
    glRotatef(torsoTwist, 0, 1, 0);

    glColor3f(p.r, p.g, p.b);
    glPushMatrix();
    glTranslatef(0.0f, 2.45f * baseScale, 0.0f);
    glScalef(1.0f * widthScale, 1.25f * baseScale, 0.7f * widthScale);
    glutSolidCube(1.0f);
    glPopMatrix();

    glColor3f(p.accentR, p.accentG, p.accentB);
    glPushMatrix();
    glTranslatef(0.0f, 2.3f * baseScale, 0.36f * widthScale);
    glScalef(0.58f * widthScale, 0.9f * baseScale, 0.18f * widthScale);
    glutSolidCube(1.0f);
    glPopMatrix();

    glColor3f(clamp01(p.r * 0.85f), clamp01(p.g * 0.85f), clamp01(p.b * 0.85f));
    glPushMatrix();
    glTranslatef(0.0f, 2.95f * baseScale, 0.0f);
    glScalef(1.05f * widthScale, 0.2f * baseScale, 0.72f * widthScale);
    glutSolidCube(1.0f);
    glPopMatrix();

    if (p.hasBackpack) {
        glColor3f(p.accentR * 0.6f, p.accentG * 0.6f, p.accentB * 0.6f);
        glPushMatrix();
        glTranslatef(0.0f, 2.45f * baseScale, -0.45f * widthScale);
        glScalef(0.7f * widthScale, 1.1f * baseScale, 0.3f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();

        glColor3f(p.accentR * 0.8f, p.accentG * 0.8f, p.accentB * 0.8f);
        glPushMatrix();
        glTranslatef(0.0f, 2.0f * baseScale, -0.65f * widthScale);
        glScalef(0.56f * widthScale, 0.4f * baseScale, 0.14f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();
    }

    auto drawArm = [&](float sideSign, float swingSign) {
        glPushMatrix();
        glTranslatef(sideSign * 0.78f * widthScale, 2.85f * baseScale, 0.0f);
        glRotatef(shoulderYaw * sideSign, 0, 1, 0);
        glRotatef(swingSign * armSwing, 1, 0, 0);

        glColor3f(clamp01(p.r * 0.88f + 0.05f), clamp01(p.g * 0.88f + 0.05f), clamp01(p.b * 0.88f + 0.05f));
        glPushMatrix();
        glTranslatef(0.0f, -0.42f * baseScale, 0.0f);
        glScalef(0.22f * widthScale, 0.82f * baseScale, 0.24f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();

        glColor3f(clamp01(p.r * 0.7f), clamp01(p.g * 0.7f), clamp01(p.b * 0.7f));
        glPushMatrix();
        glTranslatef(0.0f, -0.86f * baseScale, 0.0f);
        glutSolidSphere(0.11f * widthScale, 12, 12);
        glPopMatrix();

        glPushMatrix();
        glTranslatef(0.0f, -0.86f * baseScale, 0.0f);
        glRotatef(forearmBend, 1, 0, 0);
        glTranslatef(0.0f, -0.34f * baseScale, 0.0f);
        glColor3f(p.accentR * 0.9f, p.accentG * 0.9f, p.accentB * 0.9f);
        glScalef(0.2f * widthScale, 0.7f * baseScale, 0.21f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();

        glColor3f(skinR, skinG, skinB);
        glPushMatrix();
        glTranslatef(0.0f, -1.28f * baseScale, 0.05f);
        glRotatef(wristTilt * swingSign, 0, 1, 0);
        glScalef(0.16f * widthScale, 0.26f * baseScale, 0.12f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();

        glPopMatrix();
    };

    drawArm(-1.0f, 1.0f);
    drawArm(1.0f, -1.0f);

    glColor3f(skinR * 0.98f, skinG * 0.98f, skinB * 0.98f);
    glPushMatrix();
    glTranslatef(0.0f, 3.05f * baseScale, 0.0f);
    glScalef(0.22f * widthScale, 0.22f * baseScale, 0.22f * widthScale);
    glutSolidCube(1.0f);
    glPopMatrix();

    // HEAD - more realistic human head shape
    glColor3f(skinR, skinG, skinB);
    glPushMatrix();
    glTranslatef(0.0f, 3.45f * baseScale, 0.0f);
    
    // Apply neck rotation for natural head movement
    glRotatef(neckTurn, 0, 1, 0);  // Left-right turn
    glRotatef(neckTilt, 1, 0, 0);  // Forward-back nod

    // Neck - small connector for more natural head/torso junction
    glPushMatrix();
    glTranslatef(0.0f, -0.28f * baseScale, 0.0f);
    glRotatef(-90, 1, 0, 0);
    GLUquadric* neckQ = gluNewQuadric();
    glColor3f(skinR * 0.95f, skinG * 0.92f, skinB * 0.90f);
    gluCylinder(neckQ, 0.12f * widthScale, 0.12f * widthScale, 0.36f * baseScale, 12, 1);
    gluDeleteQuadric(neckQ);
    glPopMatrix();

    // Head sphere with better proportions
    glutSolidSphere(0.38f * baseScale, 16, 16);  // Increased detail from 8,8
    
    // FACIAL FEATURES
    // Eyes (larger and more visible)
    glColor3f(0.95f, 0.95f, 0.95f); // White of eyes
    glPushMatrix();
    glTranslatef(0.12f * widthScale, 0.08f * baseScale, 0.34f * widthScale);
    glutSolidSphere(0.06f * baseScale, 8, 8);
    glPopMatrix();
    glPushMatrix();
    glTranslatef(-0.12f * widthScale, 0.08f * baseScale, 0.34f * widthScale);
    glutSolidSphere(0.06f * baseScale, 8, 8);
    glPopMatrix();
    
    // Eyelids (for blinking effect)
    if (blinkAmount > 0.01f) {
        glColor3f(skinR * 0.95f, skinG * 0.92f, skinB * 0.90f);
        float eyelidHeight = 0.065f * baseScale * blinkAmount;
        // Left eyelid
        glPushMatrix();
        glTranslatef(0.12f * widthScale, 0.08f * baseScale, 0.36f * widthScale);
        glScalef(0.08f * widthScale, eyelidHeight, 0.02f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();
        // Right eyelid
        glPushMatrix();
        glTranslatef(-0.12f * widthScale, 0.08f * baseScale, 0.36f * widthScale);
        glScalef(0.08f * widthScale, eyelidHeight, 0.02f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();
    }
    
    // Pupils
    glColor3f(0.1f, 0.1f, 0.15f);
    glPushMatrix();
    glTranslatef(0.12f * widthScale, 0.08f * baseScale, 0.36f * widthScale);
    glutSolidSphere(0.03f * baseScale, 6, 6);
    glPopMatrix();
    glPushMatrix();
    glTranslatef(-0.12f * widthScale, 0.08f * baseScale, 0.36f * widthScale);
    glutSolidSphere(0.03f * baseScale, 6, 6);
    glPopMatrix();
    
    // Nose
    glColor3f(skinR * 0.95f, skinG * 0.9f, skinB * 0.9f);
    glPushMatrix();
    glTranslatef(0.0f, 0.0f, 0.38f * widthScale);
    glScalef(0.08f * widthScale, 0.12f * baseScale, 0.08f * widthScale);
    glutSolidCube(1.0f);
    glPopMatrix();
    
    // Mouth
    glColor3f(0.65f, 0.35f, 0.3f);
    glPushMatrix();
    glTranslatef(0.0f, -0.08f * baseScale, 0.36f * widthScale);
    glScalef(0.15f * widthScale, 0.04f * baseScale, 0.08f * widthScale);
    glutSolidCube(1.0f);
    glPopMatrix();
    
    // Ears
    glColor3f(skinR * 0.98f, skinG * 0.96f, skinB * 0.94f);
    glPushMatrix();
    glTranslatef(0.36f * widthScale, 0.05f * baseScale, 0.0f);
    glScalef(0.12f, 0.18f, 0.1f);
    glutSolidSphere(0.2f * baseScale, 8, 8);
    glPopMatrix();
    glPushMatrix();
    glTranslatef(-0.36f * widthScale, 0.05f * baseScale, 0.0f);
    glScalef(0.12f, 0.18f, 0.1f);
    glutSolidSphere(0.2f * baseScale, 8, 8);
    glPopMatrix();

    // Hair
    glColor3f(hairR, hairG, hairB);
    glPushMatrix();
    glTranslatef(0.0f, 0.19f * baseScale, 0.0f);
    glScalef(1.08f, 0.65f, 1.08f);
    glutSolidSphere(0.38f * baseScale, 12, 10);  // Increased detail from 8,6
    glPopMatrix();

    if (p.hasHat) {
        glColor3f(p.hatR, p.hatG, p.hatB);
        glPushMatrix();
        glTranslatef(0.0f, 0.36f * baseScale, 0.0f);
        glScalef(0.52f * widthScale, 0.24f * baseScale, 0.52f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();

        glColor3f(p.hatR * 0.9f, p.hatG * 0.9f, p.hatB * 0.9f);
        glPushMatrix();
        glTranslatef(0.0f, 0.22f * baseScale, 0.0f);
        glScalef(0.85f * widthScale, 0.08f * baseScale, 0.85f * widthScale);
        glutSolidCube(1.0f);
        glPopMatrix();
    }

    glPopMatrix(); // head group
    glPopMatrix(); // torso group
    glPopMatrix(); // root

    if (!normalizeWasEnabled) {
        glDisable(GL_NORMALIZE);
    }
    glShadeModel(previousShade);
}

// Simplified seated rider for two-wheelers
void drawRiderSimple(float scale, float bodyR, float bodyG, float bodyB) {
    // scale ~1.0 corresponds to about pedestrian size; two-wheeler will pass a smaller scale
    GLboolean normWas = glIsEnabled(GL_NORMALIZE);
    if (!normWas) glEnable(GL_NORMALIZE);

    glPushMatrix();
    glScalef(scale, scale, scale);

    // torso
    glColor3f(bodyR, bodyG, bodyB);
    glPushMatrix();
    glTranslatef(0.0f, 3.0f, 0.0f);
    glScalef(0.6f, 0.9f, 0.4f);
    glutSolidCube(1.0);
    glPopMatrix();

    // head
    glColor3f(0.92f, 0.82f, 0.72f);
    glPushMatrix();
    glTranslatef(0.0f, 3.8f, 0.15f);
    glutSolidSphere(0.22, 8, 6);  // Reduced from 14,12
    glPopMatrix();

    // legs (bent forward)
    glColor3f(0.2f, 0.25f, 0.3f);
    for (float s : {-0.25f, 0.25f}) {
        glPushMatrix();
        glTranslatef(s, 2.5f, -0.15f);
        glRotatef(40.0f, 1, 0, 0);
        glScalef(0.18f, 0.6f, 0.18f);
        glutSolidCube(1.0);
        glPopMatrix();
    }

    // arms to handlebars
    glColor3f(bodyR * 0.8f, bodyG * 0.8f, bodyB * 0.8f);
    for (float s : {-0.28f, 0.28f}) {
        glPushMatrix();
        glTranslatef(s, 3.2f, 0.15f);
        glRotatef(20.0f, 1, 0, 0);
        glScalef(0.14f, 0.5f, 0.14f);
        glutSolidCube(1.0);
        glPopMatrix();
    }

    // simple helmet
    glColor3f(0.2f, 0.2f, 0.22f);
    glPushMatrix();
    glTranslatef(0.0f, 3.95f, 0.12f);
    glScalef(0.55f, 0.35f, 0.55f);
    glutSolidSphere(0.28, 8, 6);  // Reduced from 12,10
    glPopMatrix();

    glPopMatrix();
    if (!normWas) glDisable(GL_NORMALIZE);
}

void generateRoadTexture() {
    const int size = 256;  // Higher resolution for better quality
    std::vector<unsigned char> data(size * size * 3);

    for (int y = 0; y < size; ++y) {
        for (int x = 0; x < size; ++x) {
            // Dark gray asphalt base - realistic road color
            float base = 0.50f + static_cast<float>((x * y) % 13) * 0.005f;
            float noise = (static_cast<float>(rand() % 30) - 15.0f) * 0.005f;
            float r = base + noise;
            float g = base + noise * 0.98f;
            float b = base + noise * 0.95f;

            // Yellow center lane markers (dashed) - running horizontally, thicker and more visible
            bool centerLane = (std::abs(y - size / 2) < 4) && ((x / 20) % 2 == 0);
            
            // White edge lines at top and bottom edges only
            bool edgeLine = (y < 3 || y >= size - 3);

            if (centerLane) {
                // Bright yellow lane marker - real road yellow
                r = 1.0f;
                g = 1.0f;
                b = 0.0f;
            } else if (edgeLine) {
                // White edge lines
                r = g = b = 1.0f;
            }

            int idx = (y * size + x) * 3;
            data[idx + 0] = floatToByte(r);
            data[idx + 1] = floatToByte(g);
            data[idx + 2] = floatToByte(b);
        }
    }

    uploadTexture(roadTexture, size, data);
}

void generateBuildingTexture() {
    const int size = 128;
    std::vector<unsigned char> data(size * size * 3);

    for (int y = 0; y < size; ++y) {
        for (int x = 0; x < size; ++x) {
            // Building facade with larger, more visible windows
            int windowCycle = 12; // Larger spacing for bigger windows
            int wx = x % windowCycle;
            int wy = y % windowCycle;
            
            // Larger window area (6x6 pixels in a 12x12 grid)
            bool isWindow = (wx >= 2 && wx <= 7) && (wy >= 2 && wy <= 7);
            
            // Window frame (1 pixel border around window)
            bool isFrame = isWindow && (wx == 2 || wx == 7 || wy == 2 || wy == 7);
            
            float r, g, b;
            
            if (isFrame) {
                // Dark window frame
                r = 0.45f;
                g = 0.45f;
                b = 0.48f;
            } else if (isWindow) {
                // Darker blue-tinted glass
                r = 0.20f;
                g = 0.25f;
                b = 0.35f;
            } else {
                // Light gray/beige building wall
                r = 0.70f;
                g = 0.68f;
                b = 0.65f;
            }

            int idx = (y * size + x) * 3;
            data[idx + 0] = floatToByte(r);
            data[idx + 1] = floatToByte(g);
            data[idx + 2] = floatToByte(b);
        }
    }

    uploadTexture(buildingTexture, size, data);
}



void generateSidewalkTexture() {
    const int size = 128;
    std::vector<unsigned char> data(size * size * 3);

    for (int y = 0; y < size; ++y) {
        for (int x = 0; x < size; ++x) {
            float base = 0.55f + (static_cast<float>((x + y) % 12) - 6.0f) * 0.005f;
            bool joint = (x % 32 == 0) || (y % 24 == 0);

            float r = base;
            float g = base * 0.98f;
            float b = base * 0.95f;

            if (joint) {
                r *= 0.65f;
                g *= 0.65f;
                b *= 0.65f;
            }

            int idx = (y * size + x) * 3;
            data[idx + 0] = floatToByte(r);
            data[idx + 1] = floatToByte(g);
            data[idx + 2] = floatToByte(b);
        }
    }

    uploadTexture(sidewalkTexture, size, data);
}

void generateGrassTexture() {
    const int size = 128;
    std::vector<unsigned char> data(size * size * 3);

    for (int y = 0; y < size; ++y) {
        for (int x = 0; x < size; ++x) {
            float noise = (static_cast<float>(rand() % 100) / 100.0f - 0.5f) * 0.08f;
            float gradient = 0.32f + static_cast<float>(y) / size * 0.1f;

            float r = 0.18f + noise;
            float g = gradient + 0.35f + noise * 1.5f;
            float b = 0.14f + noise * 0.5f;

            int idx = (y * size + x) * 3;
            data[idx + 0] = floatToByte(r);
            data[idx + 1] = floatToByte(g);
            data[idx + 2] = floatToByte(b);
        }
    }

    uploadTexture(grassTexture, size, data);
}

void generateWoodTexture() {
    const int size = 128;
    std::vector<unsigned char> data(size * size * 3);

    for (int y = 0; y < size; ++y) {
        for (int x = 0; x < size; ++x) {
            float grain = std::sin((x * 0.12f) + (y * 0.05f)) * 0.08f;
            float rings = std::sin((x * 0.04f)) * 0.06f;
            float base = 0.36f + grain + rings;

            float r = base + 0.12f;
            float g = base * 0.8f;
            float b = base * 0.45f;

            int idx = (y * size + x) * 3;
            data[idx + 0] = floatToByte(r);
            data[idx + 1] = floatToByte(g);
            data[idx + 2] = floatToByte(b);
        }
    }

    uploadTexture(woodTexture, size, data);
}

void generateMetalTexture() {
    const int size = 64;
    std::vector<unsigned char> data(size * size * 3);

    for (int y = 0; y < size; ++y) {
        for (int x = 0; x < size; ++x) {
            float streak = std::sin(x * 0.35f) * 0.05f;
            float highlight = 0.55f + streak + (std::abs(y - size / 2) / static_cast<float>(size)) * 0.15f;

            float r = highlight;
            float g = highlight * 0.98f;
            float b = highlight * 0.95f;

            int idx = (y * size + x) * 3;
            data[idx + 0] = floatToByte(r);
            data[idx + 1] = floatToByte(g);
            data[idx + 2] = floatToByte(b);
        }
    }

    uploadTexture(metalTexture, size, data);
}

// Specialized facade textures
void generateHospitalTexture() {
    const int size = 128;
    std::vector<unsigned char> data(size * size * 3);
    for (int y = 0; y < size; ++y) {
        for (int x = 0; x < size; ++x) {
            // clean white facade with soft paneling and faint blue windows
            bool panel = (x % 16 == 0) || (y % 16 == 0);
            bool window = (x % 20 > 5 && x % 20 < 15) && (y % 24 > 6 && y % 24 < 16);
            float r = 0.92f, g = 0.94f, b = 0.96f;
            if (panel) { r *= 0.9f; g *= 0.9f; b *= 0.9f; }
            if (window) { r = 0.72f; g = 0.82f; b = 0.92f; }
            int idx = (y * size + x) * 3;
            data[idx + 0] = floatToByte(r);
            data[idx + 1] = floatToByte(g);
            data[idx + 2] = floatToByte(b);
        }
    }
    uploadTexture(hospitalTexture, size, data);
}

void generateMallTexture() {
    const int size = 128;
    std::vector<unsigned char> data(size * size * 3);
    for (int y = 0; y < size; ++y) {
        for (int x = 0; x < size; ++x) {
            // large glass panels with metallic mullions
            bool mullion = (x % 24 == 0) || (y % 24 == 0);
            float base = 0.55f + (float)y / size * 0.1f;
            float r = 0.45f * base + 0.2f;
            float g = 0.65f * base + 0.2f;
            float b = 0.9f * base + 0.2f;
            if (mullion) { r = g = b = 0.78f; }
            int idx = (y * size + x) * 3;
            data[idx + 0] = floatToByte(r);
            data[idx + 1] = floatToByte(g);
            data[idx + 2] = floatToByte(b);
        }
    }
    uploadTexture(mallTexture, size, data);
}

void generateMartTexture() {
    const int size = 128;
    std::vector<unsigned char> data(size * size * 3);
    for (int y = 0; y < size; ++y) {
        for (int x = 0; x < size; ++x) {
            // light panel with colored stripes near top
            float r = 0.88f, g = 0.86f, b = 0.84f;
            if (y < 10) { r = 0.85f; g = 0.1f; b = 0.15f; }          // red band
            else if (y < 18) { r = 0.95f; g = 0.95f; b = 0.95f; }    // white gap
            else if (y < 26) { r = 0.12f; g = 0.7f; b = 0.2f; }      // green band
            bool seam = (x % 20 == 0);
            if (seam) { r *= 0.8f; g *= 0.8f; b *= 0.8f; }
            int idx = (y * size + x) * 3;
            data[idx + 0] = floatToByte(r);
            data[idx + 1] = floatToByte(g);
            data[idx + 2] = floatToByte(b);
        }
    }
    uploadTexture(martTexture, size, data);
}

// Weather particle system
void updateWeatherParticles() {
    // Remove dead particles
    weatherParticles.erase(
        std::remove_if(weatherParticles.begin(), weatherParticles.end(),
            [](const Particle& p) { return p.life <= 0.0f; }),
        weatherParticles.end()
    );
    
    // Update existing particles
    for (auto& p : weatherParticles) {
        p.x += p.vx;
        p.y += p.vy;
        p.z += p.vz;
        p.life -= 0.01f;
        
        // Reset particles that hit the ground
        if (p.y < 0.5f) {
            p.life = 0.0f;
        }
    }
    
    // Spawn new weather particles
    if (currentWeather == RAIN) {
        for (int i = 0; i < 20; i++) {
            if (weatherParticles.size() >= 2000) break;
            Particle p;
            p.x = cameraX + randomRange(-200.0f, 200.0f);
            p.y = 150.0f + randomRange(0.0f, 50.0f);
            p.z = cameraZ + randomRange(-200.0f, 200.0f);
            p.vx = randomRange(-0.5f, 0.5f);
            p.vy = -3.0f;
            p.vz = randomRange(-0.5f, 0.5f);
            p.life = 1.0f;
            p.r = 0.6f; p.g = 0.6f; p.b = 0.8f; p.a = 0.6f;
            weatherParticles.push_back(p);
        }
    } else if (currentWeather == SNOW) {
        for (int i = 0; i < 15; i++) {
            if (weatherParticles.size() >= 1500) break;
            Particle p;
            p.x = cameraX + randomRange(-200.0f, 200.0f);
            p.y = 150.0f + randomRange(0.0f, 50.0f);
            p.z = cameraZ + randomRange(-200.0f, 200.0f);
            p.vx = randomRange(-0.3f, 0.3f);
            p.vy = -0.8f;
            p.vz = randomRange(-0.3f, 0.3f);
            p.life = 1.0f;
            p.r = 0.95f; p.g = 0.95f; p.b = 1.0f; p.a = 0.8f;
            weatherParticles.push_back(p);
        }
    }
}

void drawWeatherParticles() {
    if (weatherParticles.empty()) return;
    
    glDisable(GL_LIGHTING);
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glDisable(GL_TEXTURE_2D);
    
    glBegin(GL_LINES);
    for (const auto& p : weatherParticles) {
        glColor4f(p.r, p.g, p.b, p.a * p.life);
        glVertex3f(p.x, p.y, p.z);
        if (currentWeather == RAIN) {
            glVertex3f(p.x + p.vx * 2, p.y + p.vy * 2, p.z + p.vz * 2);
        } else {
            glVertex3f(p.x, p.y - 0.5f, p.z);
        }
    }
    glEnd();
    
    glDisable(GL_BLEND);
    glEnable(GL_LIGHTING);
}

// Exhaust particle system
void updateExhaustParticles() {
    // Remove dead particles
    exhaustParticles.erase(
        std::remove_if(exhaustParticles.begin(), exhaustParticles.end(),
            [](const Particle& p) { return p.life <= 0.0f; }),
        exhaustParticles.end()
    );
    
    // Update existing particles
    for (auto& p : exhaustParticles) {
        p.x += p.vx;
        p.y += p.vy;
        p.z += p.vz;
        p.life -= 0.015f;
        p.vy += 0.02f; // Rise up
        p.a = p.life * 0.3f;
    }
    
    // Spawn exhaust from vehicles (especially trucks and buses)
    for (const auto& v : vehicles) {
        bool shouldEmit = (v.type == TRUCK || v.type == BUS) || (rand() % 100 < 5);
        if (shouldEmit && exhaustParticles.size() < 500) {
            Particle p;
            // Position at rear of vehicle
            p.x = v.x - v.dirX * v.depth * 0.5f;
            p.y = v.y - v.height * 0.3f;
            p.z = v.z - v.dirZ * v.depth * 0.5f;
            p.vx = -v.dirX * 0.1f + randomRange(-0.1f, 0.1f);
            p.vy = randomRange(-0.05f, 0.05f);
            p.vz = -v.dirZ * 0.1f + randomRange(-0.1f, 0.1f);
            p.life = 1.0f;
            p.r = 0.3f; p.g = 0.3f; p.b = 0.3f; p.a = 0.3f;
            exhaustParticles.push_back(p);
        }
    }
}

void drawExhaustParticles() {
    if (exhaustParticles.empty()) return;
    
    glDisable(GL_LIGHTING);
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    glDisable(GL_TEXTURE_2D);
    
    for (const auto& p : exhaustParticles) {
        glPushMatrix();
        glTranslatef(p.x, p.y, p.z);
        glColor4f(p.r, p.g, p.b, p.a);
        glutSolidSphere(0.3f + (1.0f - p.life) * 0.5f, 6, 6);
        glPopMatrix();
    }
    
    glDisable(GL_BLEND);
    glEnable(GL_LIGHTING);
}

void spawnPedestrians() {
    if (!intersections.empty() && (rand() % 100) < 7) {
        spawnCrosswalkPedestrian();
    }

    if ((rand() % 100) < 18) {
        spawnRoamingPedestrian();
    }
}

// Landmarks and statues arranged with intentional spacing in each park
void drawStatues() {
    GLboolean wasTexturing = glIsEnabled(GL_TEXTURE_2D);
    if (wasTexturing) glDisable(GL_TEXTURE_2D);

    auto drawLowHedge = [](float x, float z, float width, float depth) {
        glPushMatrix();
