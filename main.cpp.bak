        drawLowHedge(baseX + 15.0f, baseZ, 3.0f, 20.0f);
        drawLowHedge(baseX - 15.0f, baseZ, 3.0f, 20.0f);
        drawLowHedge(baseX, baseZ + 15.0f, 20.0f, 3.0f);
