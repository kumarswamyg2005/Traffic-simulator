        glPopMatrix();

        glPushMatrix();
        glScalef(3.0f, 0.8f, 0.35f);
        glutSolidCube(1.0f);
        glPopMatrix();

        glPushMatrix();
        glTranslatef(0, -1.8f, 0);
        glScalef(2.4f, 0.9f, 0.35f);
        glutSolidSphere(1.0, 12, 12);
        glPopMatrix();

        glPopMatrix();
    }

    // --- Southwest park: Modern Art Garden ---
    {
        const float baseX = -260.0f;
        const float baseZ = -260.0f;

        glPushMatrix();
        glTranslatef(baseX, 0.12f, baseZ);
        glColor3f(0.57f, 0.57f, 0.6f);
        drawBox(30.0f, 0.24f, 30.0f);
