// GLTF Model storage
constexpr size_t MAX_TOTAL_PEDESTRIANS = 220;
constexpr size_t MAX_ROAMING_PEDESTRIANS = 160;
constexpr float CITY_WALK_MIN = -460.0f;
constexpr float CITY_WALK_MAX = 460.0f;
constexpr float SIDEWALK_OFFSET = 24.0f;
constexpr float CROSSWALK_HALF_WIDTH = 22.0f;
constexpr float CROSSWALK_ALIGNMENT_TOLERANCE = 2.6f;
constexpr float CROSSWALK_STOP_BUFFER = 0.9f;
constexpr float CROSSWALK_EXIT_BUFFER = 0.5f;

// Day/Night and Weather System
float timeOfDay = 0.5f;  // 0.0 = midnight, 0.5 = noon, 1.0 = midnight
bool dayNightCycleEnabled = false;
// Helper: are we in night mode? (used to change visuals)
inline bool isNight() {
    // Consider night between sunset->sunrise (wrap-around)
    return (timeOfDay < 0.25f) || (timeOfDay > 0.75f);
}

