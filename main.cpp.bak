namespace {
    void uploadTexture(GLuint &textureId, int size, const std::vector<unsigned char> &data) {
        if (textureId != 0) {
            glDeleteTextures(1, &textureId);
        }
        glGenTextures(1, &textureId);
        glBindTexture(GL_TEXTURE_2D, textureId);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB, size, size, 0, GL_RGB, GL_UNSIGNED_BYTE, data.data());
    }

    inline unsigned char floatToByte(float value) {
        if (value < 0.0f) {
            value = 0.0f;
        } else if (value > 1.0f) {
            value = 1.0f;
        }
        return static_cast<unsigned char>(value * 255.0f);
    }
}

enum LightState { RED = 0, YELLOW = 1, GREEN = 2 };

enum VehicleType { CAR = 0, TRUCK = 1, BUS = 2 };

enum WeatherType { CLEAR = 0, RAIN = 1, SNOW = 2 };

struct Particle {
    float x, y, z;
    float vx, vy, vz;
    float life;
    float r, g, b, a;
};

struct Vehicle {
    VehicleType type = CAR;
    float x = 0.0f;
    float y = 0.0f;
    float z = 0.0f;
    float dirX = 0.0f;
    float dirZ = 1.0f;
    float targetDirX = 0.0f;
    float targetDirZ = 1.0f;
    float width = 4.0f;
    float height = 3.0f;
    float depth = 8.0f;
    float r = 0.7f;
    float g = 0.7f;
    float b = 0.7f;
    float speed = 0.3f;
    float wheelSpin = 0.0f;
    float lane = 0.0f;
    float turnProgress = 0.0f;
    float turnSign = 0.0f;
    bool horizontal = true;
    int turn = 0;
    int lastTurnedIntersection = -1;
    int lastCountedIntersection = -1;
    bool isWaiting = false;
    int waitingSinceFrame = -1;
    int waitingAtIntersection = -1;
};

struct Pedestrian {
    float x = 0.0f;
    float y = 0.0f;
    float z = 0.0f;
    float r = 0.5f;
    float g = 0.5f;
    float b = 0.5f;
    float speed = 0.01f;
    float progress = 0.0f;
    float legAngle = 0.0f;
    bool limbForward = true;
    int intersectionIndex = 0;
    int crossAxis = 0;
    int dir = 1;
    bool waiting = true;
    bool crossing = false;
    float walkPhase = 0.0f;
    float heightScale = 1.0f;
    float widthScale = 1.0f;
    float accentR = 0.4f;
    float accentG = 0.4f;
    float accentB = 0.4f;
    float shoeR = 0.12f;
    float shoeG = 0.12f;
    float shoeB = 0.12f;
    bool hasBackpack = false;
    bool hasHat = false;
    float hatR = 0.25f;
    float hatG = 0.25f;
    float hatB = 0.25f;
    bool roaming = false;
    bool pendingTurn = false;
    int pendingAxis = 0;
    float targetX = 0.0f;
    float targetZ = 0.0f;
    float moveDirX = 0.0f;
    float moveDirZ = 1.0f;
    float pauseTimer = 0.0f;
    float currentSpeed = 0.0f;
    float motionAmount = 0.0f;
};

struct Intersection {
    float x = 0.0f;
    float z = 0.0f;
    LightState horizontalLight = GREEN;
    LightState verticalLight = RED;
    int lightTimer = 0;
    int extraGreen = 0;
    float throughputRecent = 0.0f;
    float recentWaitSum = 0.0f;
    float recentWaitCount = 0.0f;
};

