        glColor3f(0.6f, 0.6f, 0.64f);
        drawBox(38.0f, 0.4f, 38.0f);
        glPopMatrix();

        drawLowHedge(baseX + 20.0f, baseZ, 4.0f, 26.0f);
        drawLowHedge(baseX - 20.0f, baseZ, 4.0f, 26.0f);
        drawLowHedge(baseX, baseZ + 20.0f, 26.0f, 4.0f);
        drawLowHedge(baseX, baseZ - 20.0f, 26.0f, 4.0f);

        glPushMatrix();
        glTranslatef(baseX, 3.4f, baseZ);
        glColor3f(0.82f, 0.82f, 0.86f);
        drawBox(12.0f, 2.2f, 12.0f);
        glPopMatrix();

        glPushMatrix();
        glTranslatef(baseX, 6.8f, baseZ);
        glRotatef(-90.0f, 1, 0, 0);
        GLUquadric* column = gluNewQuadric();
        gluCylinder(column, 3.2f, 3.2f, 8.0f, 24, 1);
        gluDeleteQuadric(column);
        glPopMatrix();

        glPushMatrix();
        glTranslatef(baseX, 15.8f, baseZ);
        glRotatef(frameCount * 0.08f, 0, 1, 0);

        glColor3f(0.15f, 0.4f, 0.8f);
        glutSolidSphere(6.5, 16, 16);  // Reduced from 32,32

        glColor3f(0.23f, 0.65f, 0.28f);
        glPushMatrix();
        glRotatef(25.0f, 0, 1, 0);
        glTranslatef(0, 1.8f, 5.6f);
        glutSolidSphere(2.0, 10, 10);  // Reduced from 16,16
        glPopMatrix();

        glPushMatrix();
        glRotatef(90.0f, 0, 1, 0);
        glTranslatef(0, 0.6f, 5.9f);
        glutSolidSphere(1.6, 10, 10);  // Reduced from 16,16
        glPopMatrix();

        glPushMatrix();
        glRotatef(150.0f, 0, 1, 0);
        glTranslatef(0, 1.2f, 5.5f);
        glutSolidSphere(2.3, 10, 10);  // Reduced from 16,16
        glPopMatrix();

        glColor3f(0.96f, 0.97f, 1.0f);
        glPushMatrix();
        glTranslatef(0, 5.6f, 0);
        glutSolidSphere(1.1, 8, 8);  // Reduced from 14,14
        glPopMatrix();
        glPushMatrix();
        glTranslatef(0, -5.6f, 0);
        glutSolidSphere(1.1, 8, 8);  // Reduced from 14,14
        glPopMatrix();

        glPopMatrix();
    }

    // --- Northeast park: Superman Plaza ---
    {
        const float baseX = 260.0f;
        const float baseZ = 260.0f;

        glPushMatrix();
        glTranslatef(baseX, 0.15f, baseZ);
        glColor3f(0.58f, 0.58f, 0.62f);
        drawBox(32.0f, 0.3f, 28.0f);
        glPopMatrix();

        drawLowHedge(baseX + 16.0f, baseZ, 3.0f, 22.0f);
        drawLowHedge(baseX - 16.0f, baseZ, 3.0f, 22.0f);
        drawLowHedge(baseX, baseZ + 12.0f, 22.0f, 3.0f);
        drawLowHedge(baseX, baseZ - 12.0f, 22.0f, 3.0f);

        glPushMatrix();
        glTranslatef(baseX, 3.8f, baseZ);
        glColor3f(0.7f, 0.7f, 0.73f);
        drawBox(8.0f, 1.8f, 8.0f);
        glPopMatrix();

        glPushMatrix();
        glTranslatef(baseX, 8.8f, baseZ);
        glRotatef(45.0f, 0, 0, 1);

        glColor3f(0.9f, 0.12f, 0.12f);
        glPushMatrix();
        glScalef(6.5f, 9.0f, 1.1f);
        glutSolidCube(1.0f);
        glPopMatrix();

        glColor3f(1.0f, 0.9f, 0.0f);
